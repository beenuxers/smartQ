DATABASE_URL="file:./dev.db"
# For Postgres in production:
# DATABASE_URL="postgresql://user:pass@host:5432/smartq"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# WhatsApp Cloud API (optional — falls back to console logging)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# local | stripe | xendit | ipay88
BILLING_PROVIDER="local"

# Comma-separated emails allowed to open /admin (platform console)
ADMIN_EMAILS="you@example.com"
