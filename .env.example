# Neon / Postgres (required on Vercel — SQLite is not supported)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required. Generate: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string"
# Local: http://localhost:3000
# Vercel production: https://YOUR-APP.vercel.app  (never leave localhost on Vercel)
AUTH_URL="http://localhost:3000"

# WhatsApp Cloud API (optional — falls back to console logging)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Production: use Meta-approved utility templates (cold free-form text is usually blocked).
# Template body param order — joined: outlet, queue #, parties ahead, track URL
# table_ready: outlet, queue #, track URL
WHATSAPP_TEMPLATE_JOINED=
WHATSAPP_TEMPLATE_TABLE_READY=
WHATSAPP_TEMPLATE_LANG=en

# local = mock card form | stripe = Stripe Checkout (SG/USD-first)
BILLING_PROVIDER="local"

# Stripe (required when BILLING_PROVIDER=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Comma-separated emails allowed to open /admin (platform console)
ADMIN_EMAILS="you@example.com"

# Cloudflare Turnstile (signup bot check). Leave empty to skip in local/dev.
# Create a widget at https://dash.cloudflare.com/ → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional Upstash Redis for shared rate limits across Vercel instances.
# Without these, limits are in-memory (fine for local; weak on multi-instance prod).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
