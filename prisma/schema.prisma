generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  country      String   @default("SG") // SG | ID | MY (preference order)
  locale       String   @default("en") // en | ms | id
  currency     String   @default("USD") // USD | MYR | SGD | IDR
  plan         String   @default("free") // free | starter | growth
  billingCycle String   @default("monthly") // monthly | annual
  whatsappUsed Int      @default(0)
  seatingsUsed Int      @default(0)
  usageMonth   String   @default("") // YYYY-MM
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  outlets      Outlet[]
  memberships  Membership[]
  payments     Payment[]
}

model Payment {
  id             String       @id @default(cuid())
  plan           String
  billingCycle   String
  amount         Int
  currency       String
  status         String       @default("pending") // pending | paid | failed | cancelled
  provider       String       @default("test")
  providerRef    String? // Stripe Checkout Session id, etc.
  cardLast4      String?
  failureReason  String?
  organizationId String
  createdAt      DateTime     @default(now())
  paidAt         DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([providerRef])
}

model Membership {
  id             String       @id @default(cuid())
  role           String       @default("owner") // owner | staff
  userId         String
  organizationId String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Outlet {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  timezone       String       @default("Asia/Kuala_Lumpur")
  lunchStart     String       @default("11:00")
  lunchEnd       String       @default("15:00")
  dinnerStart    String       @default("17:00")
  dinnerEnd      String       @default("22:00")
  activeSession  String       @default("all") // lunch | dinner | all
  /** HH:mm local — queue # resets at this time each day (default 04:00). */
  queueDayCutoff String       @default("04:00")
  isActive       Boolean      @default(true)
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parties        Party[]
  tables         DiningTable[]
}

model DiningTable {
  id        String    @id @default(cuid())
  outletId  String
  name      String
  seats     Int       @default(2)
  status    String    @default("free") // free | occupied | dirty
  sortOrder Int       @default(0)
  partyId   String?   @unique
  seatedAt  DateTime?
  clearedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  outlet    Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  party     Party?    @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([outletId, sortOrder])
  @@index([outletId, status])
}

model Party {
  id           String       @id @default(cuid())
  token        String       @unique
  queueNumber  Int
  guestName    String
  partySize    Int
  phone        String
  notes        String?
  status       String       @default("waiting") // waiting | notified | seated | no_show | cancelled
  positionLink String
  joinedAt     DateTime     @default(now())
  notifiedAt   DateTime?
  seatedAt     DateTime?
  completedAt  DateTime?
  outletId     String
  outlet       Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  diningTable  DiningTable?

  @@index([outletId, status])
  @@index([outletId, joinedAt])
}
